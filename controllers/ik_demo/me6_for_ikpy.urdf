<?xml version="1.0" ?>
<!--
  Minimal URDF of the Dobot Me6 robot for use with ikpy.
  - No mesh references (ikpy only needs kinematics)
  - No duplicate links
  - Includes a fixed end_effector link at the tool tip
  - All dimensions in meters, angles in radians
-->
<robot name="me6">

  <!-- ==================== BASE ==================== -->
  <link name="world"/>

  <link name="base_link"/>
  <joint name="world_to_base" type="fixed">
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- ==================== LINK 1 — joint 1 (yaw around Z) ==================== -->
  <link name="Link1"/>
  <joint name="joint1" type="revolute">
    <origin xyz="0 0 0.1268" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="Link1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="300" velocity="300"/>
  </joint>

  <!-- ==================== LINK 2 — joint 2 ==================== -->
  <link name="Link2"/>
  <joint name="joint2" type="revolute">
    <origin xyz="-0.046 0 0.04" rpy="1.5708 0 -1.5708"/>
    <parent link="Link1"/>
    <child link="Link2"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.356" upper="2.356" effort="300" velocity="300"/>
  </joint>

  <!-- ==================== LINK 3 — joint 3 ==================== -->
  <link name="Link3"/>
  <joint name="joint3" type="revolute">
    <origin xyz="0 0.18906 0.003" rpy="0 0 0"/>
    <parent link="Link2"/>
    <child link="Link3"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.6878" upper="2.6878" effort="300" velocity="300"/>
  </joint>

  <!-- ==================== LINK 4 — joint 4 ==================== -->
  <link name="Link4"/>
  <joint name="joint4" type="revolute">
    <origin xyz="0 0.16 0.005" rpy="0 0 0"/>
    <parent link="Link3"/>
    <child link="Link4"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.7925" upper="2.7925" effort="300" velocity="300"/>
  </joint>

  <!-- ==================== LINK 5 — joint 5 ==================== -->
  <link name="Link5"/>
  <joint name="joint5" type="revolute">
    <origin xyz="0 0.067 0.032" rpy="-1.5708 1.5708 0"/>
    <parent link="Link4"/>
    <child link="Link5"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.0194" upper="3.0194" effort="300" velocity="300"/>
  </joint>

  <!-- ==================== LINK 6 — joint 6 ==================== -->
  <link name="Link6"/>
  <joint name="joint6" type="revolute">
    <origin xyz="-0.047 0 0.034" rpy="1.5708 0 -1.5708"/>
    <parent link="Link5"/>
    <child link="Link6"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="300" velocity="300"/>
  </joint>

  <!-- ==================== END EFFECTOR (tool tip) ==================== -->
  <link name="end_effector"/>
  <joint name="end_effector_joint" type="fixed">
    <!-- ~60 mm along Z of Link6 to reach the flange face -->
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <parent link="Link6"/>
    <child link="end_effector"/>
  </joint>

</robot>
